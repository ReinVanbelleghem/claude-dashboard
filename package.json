{
  "name": "claude-dashboard",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "setup": "./install.sh",
    "package": "./scripts/package.sh",
    "app:mac": "./scripts/build-app.sh",
    "dev": "./start.sh",
    "dev:beside": "DASHBOARD_BESIDE=1 ./start.sh",
    "server": "bun run --watch server/index.ts",
    "ui": "vite",
    "build": "vite build",
    "start": "bun run server/index.ts",
    "reindex": "bun run server/reindex.ts",
    "icons": "python3 scripts/make-icons.py"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.231",
    "@excalidraw/excalidraw": "0.18.1",
    "@milkdown/crepe": "7.23.0",
    "@milkdown/kit": "7.23.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "monaco-editor": "0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.0.0"
  },
  "trustedDependencies": [
    "electron"
  ],
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
